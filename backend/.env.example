# Copy to .env to override defaults. All variables are optional.
JOBORBIT_HOST=127.0.0.1
JOBORBIT_PORT=8765
JOBORBIT_DATA_DIR=data
# Defaults to sqlite:///<data_dir>/joborbit.db
# JOBORBIT_DATABASE_URL=
JOBORBIT_LOG_LEVEL=INFO
# Sessions (NFR-013)
JOBORBIT_SESSION_IDLE_DAYS=7
JOBORBIT_SESSION_ABSOLUTE_DAYS=30
# Set to true when a TLS reverse proxy (e.g. Caddy) is in front of the app.
JOBORBIT_HTTPS_TERMINATED=false
# Only for trusted networks: allow plain HTTP on a non-loopback interface.
JOBORBIT_ALLOW_INSECURE_HTTP=false
# PostgreSQL instead of SQLite (`docker compose up -d db` from the repo root):
# JOBORBIT_DATABASE_URL=postgresql+psycopg://joborbit:joborbit@127.0.0.1:55432/joborbit
